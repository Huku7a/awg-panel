[Unit]
Description=AWG Panel - AmneziaWG management web UI
After=network.target awg-quick@awg0.service
Wants=awg-quick@awg0.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/awg-panel
ExecStart=/root/awg-panel/venv/bin/uvicorn app:app --host 0.0.0.0 --port 5182
Environment=AWG_CONFIG_DIR=/etc/amnezia/amneziawg
Environment=AWG_INTERFACE=awg0
Environment=AWG_STATE_FILE=/root/awg-panel/state.json
Environment=AWG_CLIENT_DIR=/root
EnvironmentFile=/etc/awg-panel/config
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target