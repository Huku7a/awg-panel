[Unit]
Description=AWG Agent - AmneziaWG management agent for remote VDS
After=network.target awg-quick@awg0.service
Wants=awg-quick@awg0.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/awg-agent
ExecStart=/root/awg-agent/venv/bin/uvicorn agent:app --host 0.0.0.0 --port 5183
Environment=AWG_CONFIG_DIR=/etc/amnezia/amneziawg
Environment=AWG_INTERFACE=awg0
Environment=AWG_STATE_FILE=/root/awg-agent/state.json
Environment=AWG_CLIENT_DIR=/root
EnvironmentFile=/etc/awg-panel/agent-config
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target